# OPENROUTER CONFIGURATION
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk_live_...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# PRIMARY MODEL (must be a real OpenRouter model)
# Options: google/gemma-3-4b-it:free, openrouter/auto, deepseek/deepseek-chat, etc.
OPENROUTER_PRIMARY_MODEL=google/gemma-3-4b-it:free

# FALLBACK MODELS (if primary fails)
OPENROUTER_FALLBACK_MODELS=openrouter/auto

# RETRIEVAL CONFIGURATION
# Options: local-content, supabase-pgvector
RETRIEVAL_MODE=local-content

# SUPABASE (optional, only if using pgvector)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PORT
PORT=8100

# ENVIRONMENT
ENVIRONMENT=development
DEBUG=true
